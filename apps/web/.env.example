# ==========================================
# Vũ Bách Auto - Environment Variables
# Copy this file to .env.local and fill in values
# ==========================================

# Public site URL (used for SEO metadata, sitemap, Open Graph)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Business contact info (surfaced in UI)
NEXT_PUBLIC_HOTLINE=0975224557
NEXT_PUBLIC_ZALO=0975224557
NEXT_PUBLIC_EMAIL=lienhe@vubachauto.vn

# ImgBB API (Optional - for admin image upload)
# Sign up at https://imgbb.com/ to get your free API key
NEXT_PUBLIC_IMGBB_API_KEY=your_imgbb_api_key_here

# Cloudinary (Alternative image host - also free)
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=your_cloud_name
NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET=your_upload_preset

# Admin panel password (client-side gate for the mock CMS)
NEXT_PUBLIC_ADMIN_PASSWORD=admin123
