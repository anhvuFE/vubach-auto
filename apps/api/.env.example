# ==========================================
# Vũ Bách Auto - API (NestJS) environment
# Copy to .env and fill in values
# ==========================================

# Port the NestJS server listens on
PORT=4000

# Comma-separated list of allowed CORS origins (the web app)
CORS_ORIGIN=http://localhost:3000

# PostgreSQL connection string used by Prisma
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/vubach_auto?schema=public
