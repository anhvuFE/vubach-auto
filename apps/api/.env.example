# ==========================================
# Vũ Bách Auto - API (NestJS) environment
# Copy to .env and fill in values
# ==========================================

# Port the NestJS server listens on
PORT=4000

# Comma-separated list of allowed CORS origins (the web app)
CORS_ORIGIN=http://localhost:3000

# PostgreSQL connection string used by Prisma
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
DATABASE_URL=postgresql://postgres:postgres@localhost:5433/vubach_auto?schema=public

# Secret used to sign JWT access tokens — use a long random string in production
JWT_SECRET=change-me-to-a-long-random-secret
# Access token lifetime (any ms-style string, e.g. 15m, 1h)
JWT_ACCESS_EXPIRES_IN=15m
# Refresh token lifetime in days (stored server-side, rotated on each use)
JWT_REFRESH_EXPIRES_DAYS=7
