// Prisma schema for the Vũ Bách Auto API.
// Provider is PostgreSQL; connection string comes from DATABASE_URL.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// A car listing. String fields (transmission, fuelType, bodyType, condition,
/// status) mirror the union types in @vubach/shared rather than DB enums, so the
/// Vietnamese labels stay the single source of truth on the TypeScript side.
model Car {
  id           String   @id @default(cuid())
  slug         String   @unique
  brand        String
  model        String
  year         Int
  price        Int
  mileage      Int
  transmission String
  fuelType     String
  bodyType     String
  condition    String
  color        String
  seats        Int
  origin       String
  description  String
  features     String[]
  images       String[]
  mainImage    String
  status       String   @default("available")
  isFeatured   Boolean  @default(false)
  contactPhone String?
  contactName  String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([brand])
  @@index([status])
  @@map("cars")
}

/// An authenticated account. `role` mirrors the UserRole union in @vubach/shared
/// ("USER" | "ADMIN") rather than a DB enum, keeping labels on the TS side.
/// `password` stores a bcrypt hash and is never returned to clients.
model User {
  id            String         @id @default(cuid())
  email         String         @unique
  password      String
  name          String
  role          String         @default("USER")
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  refreshTokens RefreshToken[]

  @@map("users")
}

/// A long-lived refresh token issued at login/register. Only the SHA-256 hash
/// of the token is stored so a DB leak can't be replayed. Tokens are rotated on
/// every refresh (old row gets `revokedAt`) so reuse of a stale token is detectable.
model RefreshToken {
  id        String    @id @default(cuid())
  tokenHash String    @unique
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
  @@map("refresh_tokens")
}
